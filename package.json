{
  "name": "wmata-design-system-storybook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "sass src/index.scss dist/wmata-theme.css --style=compressed",
    "dev": "npm run build && vite",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "watch": "sass --watch src/index.scss dist/wmata-theme.css"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-interactions": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass": "^1.80.0",
    "vite": "^7.2.7"
  }
}
